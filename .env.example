# Safe default: all MCP data/actions are synthetic. Vercel always forces this mode.
ZERNIO_MCP_MOCK=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
OPENROUTER_SCOPE_MODEL=typesafe/jev-1.14
# One fallback on transient Jev failure; set blank to disable.
OPENROUTER_SCOPE_FALLBACK_MODEL=openai/gpt-6-luna-decisions
DEMO_SIGNING_SECRET=
PUBLIC_APP_ORIGIN=

# Local real-account mode only: set ZERNIO_MCP_MOCK=false, opt in below and add your own key.
ZERNIO_DOCS_MCP_ENABLED=true
ZERNIO_ACCOUNT_MCP_ENABLED=false
ZERNIO_API_KEY=
# Optional local durable action ledger. Never commit its contents.
ZEN_STATE_DIR=
